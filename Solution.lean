module

public import Mathlib
public import Grotzsch

/-!
# Proofs of the statements in `Challenge.lean`

The definitions below are verbatim copies of those in `Challenge.lean`. They coincide
definitionally with the definitions of the `LeanPool.K5MinorFreeChoosability` planarity library
included in this repository (`isPlanar_iff_lib`), and the theorems are proved from that library
and from the `Grotzsch` development (`Grotzsch.Ore`: Kostochka–Yancey bound; `Grotzsch.Planar`:
Grötzsch's theorem for `V : Type`, transferred here to arbitrary universes; `Grotzsch.PlusEdge`
and `Grotzsch.PlusVertex`: BKLY Theorems 2 and 4; `Grotzsch.GACase3`: the Grünbaum–Aksenov
theorem, on top of the region theorem `Grotzsch.Regions` and the precolouring extension
`Grotzsch.CycleExtension`).
-/

@[expose] public section

noncomputable section

open Equiv Equiv.Perm

namespace GrotzschKY

/-! ### Combinatorial planarity -/

section Hypermap

variable {α : Type*}

/-- The number of equivalence classes of a setoid. -/
noncomputable def numClasses (s : Setoid α) : ℕ := Nat.card (Quotient s)

/-- The number of cycles of a permutation (fixed points count as cycles of length one). -/
noncomputable def cycleCount (π : Perm α) : ℕ := numClasses (SameCycle.setoid π)

/-- The relation "in the same orbit of the group generated by `σ` and `τ`". -/
def compSetoid (σ τ : Perm α) : Setoid α where
  r := Relation.EqvGen (fun a b => b = σ a ∨ b = τ a)
  iseqv := Relation.EqvGen.is_equivalence _

/-- The number of orbits of the group generated by `σ` and `τ`. -/
noncomputable def numComponents (σ τ : Perm α) : ℕ := numClasses (compSetoid σ τ)

/-- The Euler defect `|α| + 2 K - c(σ) - c(τ) - c(σ τ)` of the hypermap `(σ, τ)`; it equals
twice the genus. -/
noncomputable def eulerDefect (σ τ : Perm α) : ℤ :=
  (Nat.card α : ℤ) + 2 * (numComponents σ τ : ℤ) - cycleCount σ - cycleCount τ -
    cycleCount (σ * τ)

end Hypermap

section Planar

variable {V : Type*} (G : SimpleGraph V)

/-- The dart reversal `d ↦ d.symm` of `G`, as a permutation of the darts. -/
def dartSymm : Perm G.Dart := Function.Involutive.toPerm _ SimpleGraph.Dart.symm_involutive

/-- A rotation system: a permutation of the darts preserving tails and cyclic on the darts at
each vertex. -/
structure IsRotationSystem (σ : Perm G.Dart) : Prop where
  fst_apply : ∀ d, (σ d).fst = d.fst
  sameCycle : ∀ d e : G.Dart, d.fst = e.fst → σ.SameCycle d e

/-- A plane map of `G`: a rotation system of genus zero (Euler defect `0`). -/
structure PlaneMap where
  /-- The rotation: the next dart around the tail. -/
  rot : Perm G.Dart
  isRotationSystem : IsRotationSystem G rot
  eulerDefect_eq_zero : eulerDefect rot (dartSymm G) = 0

/-- `G` is planar: it has a plane map. -/
def IsPlanar : Prop := Nonempty (PlaneMap G)

end Planar

/-- The planarity notion of this file is that of the `K5MinorFreeChoosability` library. -/
theorem isPlanar_iff_lib {V : Type*} (G : SimpleGraph V) :
    IsPlanar G ↔ LeanPool.K5MinorFreeChoosability.IsPlanar G := by
  constructor
  · rintro ⟨M⟩
    exact ⟨⟨M.rot, ⟨M.isRotationSystem.1, M.isRotationSystem.2⟩, M.eulerDefect_eq_zero⟩⟩
  · rintro ⟨M⟩
    exact ⟨⟨M.rot, ⟨M.isRotationSystem.1, M.isRotationSystem.2⟩, M.eulerDefect_eq_zero⟩⟩

/-! ### Sanity checks on the definition of planarity -/

/-- `K₄` is planar. -/
theorem isPlanar_K4 : IsPlanar (⊤ : SimpleGraph (Fin 4)) :=
  (isPlanar_iff_lib _).2 LeanPool.K5MinorFreeChoosability.isPlanar_K4

/-- `K₅` is not planar. -/
theorem not_isPlanar_K5 : ¬ IsPlanar (⊤ : SimpleGraph (Fin 5)) := fun h =>
  LeanPool.K5MinorFreeChoosability.not_isPlanar_K5 ((isPlanar_iff_lib _).1 h)

/-- `K₃,₃` is not planar. -/
theorem not_isPlanar_K33 : ¬ IsPlanar (completeBipartiteGraph (Fin 3) (Fin 3)) := fun h =>
  LeanPool.K5MinorFreeChoosability.not_isPlanar_K33 ((isPlanar_iff_lib _).1 h)

/-! ### 4-critical graphs and the Kostochka–Yancey bound -/

/-- `G` is 4-critical: not 3-colourable, but deleting any vertex or any edge gives a
3-colourable graph. -/
structure IsCritical4 {V : Type*} (G : SimpleGraph V) : Prop where
  not_colorable : ¬ G.Colorable 3
  vertex : ∀ v, (G.induce {w | w ≠ v}).Colorable 3
  edge : ∀ e ∈ G.edgeSet, (G.deleteEdges {e}).Colorable 3

/-- **Kostochka–Yancey (Ore's conjecture for `k = 4`).** Every finite 4-critical graph has at
least `(5 |V| - 2) / 3` edges. -/
theorem ore_four {V : Type} [Fintype V] (G : SimpleGraph V) (hG : IsCritical4 G) :
    5 * Fintype.card V ≤ 3 * Nat.card G.edgeSet + 2 := by
  have h := Grotzsch.five_mul_card_le G ⟨hG.1, hG.2, hG.3⟩
  rwa [Grotzsch.card_edgeFinset_eq_natCard] at h

/-! ### Grötzsch's theorem -/

/-- **Grötzsch's theorem.** Every finite triangle-free planar graph is 3-colourable. -/
theorem grotzsch {V : Type*} [Fintype V] (G : SimpleGraph V) (hP : IsPlanar G)
    (h3 : G.CliqueFree 3) : G.Colorable 3 := by
  -- transfer to the vertex type `Fin (card V)` in `Type`
  let e := Fintype.equivFin V
  let iso : G ≃g G.map e.toEmbedding := SimpleGraph.Iso.map e G
  have hP' : LeanPool.K5MinorFreeChoosability.IsPlanar (G.map e.toEmbedding) :=
    LeanPool.K5MinorFreeChoosability.isPlanar_of_iso ((isPlanar_iff_lib G).1 hP) iso.symm
  have h3' : (G.map e.toEmbedding).CliqueFree 3 := h3.comap iso.symm.toEmbedding.isContained
  exact (Grotzsch.grotzsch _ hP' h3').of_hom iso.toHom

/-! ### Near-triangle-free planar graphs -/

/-- **Aksenov (1974); Jensen–Thomassen (2000).** If deleting the edge `uv` from `H` leaves a
triangle-free planar graph, then `H` is 3-colourable. -/
theorem colorable_of_planar_add_edge {V : Type} [Fintype V] (H : SimpleGraph V) {u v : V}
    (huv : u ≠ v) (hP : IsPlanar (H.deleteEdges {s(u, v)}))
    (h3 : (H.deleteEdges {s(u, v)}).CliqueFree 3) : H.Colorable 3 :=
  Grotzsch.colorable_of_sdiff_edge H huv ((isPlanar_iff_lib _).1 hP) h3

/-- **Borodin–Kostochka–Lidický–Yancey (2014), Theorem 4.** If deleting the vertex `v` from `H`
leaves a triangle-free planar graph and `v` has at most four neighbours, then `H` is
3-colourable. -/
theorem colorable_of_planar_add_vertex {V : Type} [Fintype V] (H : SimpleGraph V) (v : V)
    (hP : IsPlanar (H.induce {w | w ≠ v})) (h3 : (H.induce {w | w ≠ v}).CliqueFree 3)
    (hv : Nat.card (H.neighborSet v) ≤ 4) : H.Colorable 3 := by
  classical
  refine Grotzsch.colorable_of_induce_planar_cliqueFree H v ((isPlanar_iff_lib _).1 hP) h3 ?_
  rwa [Nat.card_eq_fintype_card, SimpleGraph.card_neighborSet_eq_degree] at hv

/-! ### The Grünbaum–Aksenov theorem -/

/-- **Grünbaum–Aksenov theorem.** Every finite planar graph with at most three triangles is
3-colourable. A triangle is a set of three pairwise adjacent vertices. -/
theorem grunbaum_aksenov {V : Type} [Fintype V] (G : SimpleGraph V) (hP : IsPlanar G)
    (ht : Nat.card {s : Finset V // G.IsNClique 3 s} ≤ 3) : G.Colorable 3 :=
  Grotzsch.grunbaum_aksenov G ((isPlanar_iff_lib G).1 hP) ht

end GrotzschKY
